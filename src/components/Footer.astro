---
import { u } from '../utils/url';
import salon from '../data/salon.json';
---
<footer class="foot">
  <div>
    <a class="brand" href={u('/')}>So Coif'</a>
    <p>{salon.slogan}</p>
    <p class="maquette">Maquette non officielle, en attente de validation par le salon.</p>
  </div>
  <div>
    <h3>Le salon</h3>
    <ul>
      <li><a href={u('/salon')}>Notre histoire</a></li>
      <li><a href={u('/prestations')}>Prestations et tarifs</a></li>
      <li><a href={u('/equipe')}>L'équipe</a></li>
      <li><a href={u('/galerie')}>Galerie</a></li>
      <li><a href={u('/avis')}>Avis clients</a></li>
    </ul>
  </div>
  <div>
    <h3>Nous trouver</h3>
    <p>{salon.adresse.rue}<br />{salon.adresse.codePostal} {salon.adresse.ville}</p>
    <p><a href={`tel:${salon.telephoneInternational}`}>{salon.telephone}</a><br /><a href={`mailto:${salon.email}`}>{salon.email}</a></p>
    <ul>
      <li><a href={u('/contact')}>Contact et horaires</a></li>
      <li><a href={u('/mentions-legales')}>Mentions légales</a></li>
    </ul>
  </div>
</footer>
