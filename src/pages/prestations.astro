---
import { u } from '../utils/url';
import Base from '../layouts/Base.astro';
import salon from '../data/salon.json';
import data from '../data/prestations.json';
---
<Base
  title="Prestations et tarifs | So Coif' Willems"
  description="Tous les tarifs de So Coif' à Willems : coupe homme et femme, rasage à l'ancienne, couleur, permanente, lissage, soins Keune, maquillage."
>
  <div class="doc">
    <h1>Prestations et tarifs</h1>
    <p class="intro">{data.introduction}</p>

    <div class="chips" role="group" aria-label="Filtrer par catégorie" id="filtres" hidden>
      <button class="chip" type="button" data-f="all" aria-pressed="true">Tout</button>
      {data.categories.map((c) => (
        <button class="chip" type="button" data-f={c.id} aria-pressed="false">{c.filtre}</button>
      ))}
    </div>

    <div class="paper" id="carte">
      {data.categories.map((c: any) => (
        <section class="pgroup" data-cat={c.id} aria-labelledby={`cat-${c.id}`}>
          <h2 id={`cat-${c.id}`}>{c.titre}</h2>
          {c.intro && <p class="gi">{c.intro}</p>}
          <ul class="plist">
            {c.prestations.map((p: any) => (
              <li>
                <div class="row"><span>{p.nom}</span><span class="dots" aria-hidden="true"></span><span class="p">{p.prix}</span></div>
                {(p.duree || p.description) && (
                  <p class="d">{p.duree && <span>{p.duree}</span>}{p.description}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p style="margin-top:2rem">
      <a class="btn" href={salon.reservation} target="_blank" rel="noopener">Réserver sur Planity</a>
      <a class="btn ghost" href={u('/contact')}>Une question ? Écrivez-nous</a>
    </p>
    <p class="fine">{data.noteBasDePage}</p>
  </div>
</Base>

<script>
  // Filtres par catégorie : sans JavaScript, toute la carte reste affichée.
  const barre = document.getElementById('filtres');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const groupes = Array.from(document.querySelectorAll<HTMLElement>('.pgroup'));
  if (barre) {
    barre.hidden = false;
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const f = chip.dataset.f;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        groupes.forEach((g) => { g.hidden = !(f === 'all' || g.dataset.cat === f); });
      });
    });
  }
</script>
